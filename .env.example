# --- Navigateur (publiques, préfixe VITE_) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Serveur uniquement (variables d'environnement Netlify, JAMAIS dans le code) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...          # destination « Your account » (paiements)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...  # destination « Connected accounts » (account.updated)
# Commission de la plateforme sur chaque paiement, en points de base (100 = 1 %). 0 par défaut.
PLATFORM_FEE_BPS=0

# Courriels (Resend). Sans clé, les envois sont simulés et seulement journalisés.
RESEND_API_KEY=
EMAIL_FROM="RelanceFacile <factures@ton-domaine.com>"

# Adresse publique du site (Netlify fournit URL automatiquement en production)
SITE_URL=http://localhost:8888
